# Mock server (local `npm run dev:server` / `npm run dev:all`)
PORT=4000
HOST=0.0.0.0

# Optional: force client empty/error states — empty | error
# MOCK_FORCE=empty

# Client — base URL the client uses to reach the API.
# In dev this points straight at the mock server. Docker/nginx uses the
# DOCKER_VITE_* values below (same-origin; nginx proxies /api).
VITE_API_URL=http://localhost:4000

# Real-time updates endpoint. Leave as-is unless you change the
# transport (SSE path, WS path, etc.) — update alongside docs/data-model.md.
VITE_REALTIME_URL=http://localhost:4000/api/org-tree/stream

# Docker Compose — host port for nginx (open http://localhost:$CLIENT_PORT)
CLIENT_PORT=8080

# Baked into the production client at image build time. Empty API URL means
# the browser calls /api on the same origin; nginx proxies to mock-server.
# Do not reuse VITE_API_URL=http://localhost:4000 here.
DOCKER_VITE_API_URL=
DOCKER_VITE_REALTIME_URL=/api/org-tree/stream
